{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "./.cloudflare/types/index.d.ts"
    ],
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "src/**/*.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    ".cloudflare/types/**/*.d.ts"
  ]
}
