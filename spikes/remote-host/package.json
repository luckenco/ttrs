{
  "name": "ttrs-remote-host-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "cargo build --manifest-path fallback/Cargo.toml --target-dir fallback/target --release --target wasm32-unknown-unknown --locked && cf build --mode fallback",
    "dev": "cf dev --mode fallback",
    "check:startup": "cf workers check --prebuilt --mode fallback --outfile results/fallback-startup.cpuprofile",
    "test": "node fallback/test.mjs",
    "test:mcp": "node mcp-test.mjs",
    "build:rust-repro": "worker-build --release && cf build --mode rust-repro",
    "test:rust-repro": "node gate-test.mjs",
    "build:fallback": "npm run build",
    "test:fallback": "node fallback/test.mjs",
    "check:js": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "24.10.1",
    "agents": "0.28.1",
    "cf": "1.0.0-beta.14",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "zod": "4.6.5"
  }
}
